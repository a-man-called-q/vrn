{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "@types/node",
      "bun-types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "templates",
    "dist",
    "node_modules"
  ]
}