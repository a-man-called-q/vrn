# ─── Server ───────────────────────────────────────────────────────
PORT={{apiPort}}

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db_{{snakeCase name}}

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ─── Zitadel ──────────────────────────────────────────────────────
# Webhook signing secret — must match the secret configured in Zitadel Actions
# Generate with: openssl rand -hex 32
ZITADEL_WEBHOOK_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://backoffice-{{dashCase name}}.localhost,http://portal-{{dashCase name}}.localhost
