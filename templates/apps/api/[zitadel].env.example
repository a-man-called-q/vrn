# ─── Server ───────────────────────────────────────────────────────
PORT={{apiPort}}

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db_{{snakeCase name}}

# ─── Auth ─────────────────────────────────────────────────────────
# Better Auth signing secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ─── Zitadel OIDC Provider ────────────────────────────────────────
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://backoffice-{{dashCase name}}.localhost,http://portal-{{dashCase name}}.localhost
