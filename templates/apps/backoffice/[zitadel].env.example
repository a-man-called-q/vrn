# ─── API ──────────────────────────────────────────────────────────
# URL apps/api (internal docker: http://api:4000, dev: http://localhost:4000)
API_URL=http://localhost:4000

# ─── Zitadel ──────────────────────────────────────────────────────
# Public URL Zitadel console (untuk link "Open Auth Console")
ZITADEL_PUBLIC_URL=https://auth.localhost

# ─── OAuth Redirect URIs ──────────────────────────────────────────
# Harus terdaftar di Zitadel application (via seeder)
REDIRECT_URI=http://localhost:5174/auth/callback
POST_LOGOUT_URI=http://localhost:5174/login

# ─── Session ──────────────────────────────────────────────────────
# Generate dengan: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
SESSION_SECRET=
