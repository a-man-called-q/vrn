
  # ─── APPLICATION {{upperCase name}} ─────────────────────────────────────────────────

{{#each services}}
  # ─── SERVICE {{upperCase name}} ─────────────────────────────────────────────────
  db-{{dashCase name}}:
    image: postgres:17-alpine
    restart: unless-stopped
    networks:
      - proxy
    environment:
      POSTGRES_USER: ${APP_{{constantCase name}}_DB_USER:-postgres}
      POSTGRES_PASSWORD: ${APP_{{constantCase name}}_DB_PASSWORD:?required}
      POSTGRES_DB: ${APP_{{constantCase name}}_DB_NAME:-db_{{snakeCase name}}{{cb}}
    volumes:
      - ./db-{{dashCase name}}-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d ${APP_{{constantCase name}}_DB_NAME:-db_{{snakeCase name}}{{cb}} -U ${APP_{{constantCase name}}_DB_USER:-postgres}"]
      interval: 10s
      timeout: 30s
      retries: 10
      start_period: 20s

  {{dashCase name}}-service:
    build:
      context: ../
      dockerfile: apps/{{dashCase name}}-service/Dockerfile
    restart: unless-stopped
    networks:
      - proxy
    environment:
      PORT: {{port}}
{{#if (eq ../authMode "zitadel")}}
      ZITADEL_ISSUER: ${ZITADEL_PUBLIC_URL:-https://auth.localhost}
      ZITADEL_CLIENT_ID: ${API_{{constantCase name}}_ZITADEL_CLIENT_ID:-}
      ZITADEL_CLIENT_SECRET: ${API_{{constantCase name}}_ZITADEL_CLIENT_SECRET:?required}
{{/if}}
      BETTER_AUTH_SECRET: ${APP_{{constantCase name}}_BETTER_AUTH_SECRET:?required}
      BETTER_AUTH_URL: ${API_{{constantCase name}}_URL:-http://{{dashCase name}}-service.localhost}
      ALLOWED_ORIGINS: ${BACKOFFICE_{{constantCase name}}_APP_URL:-http://backoffice-{{dashCase name}}.localhost},${PORTAL_{{constantCase name}}_APP_URL:-http://portal-{{dashCase name}}.localhost}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{port}}/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    depends_on:
      db-{{dashCase name}}:
        condition: service_healthy
{{#if (eq ../authMode "zitadel")}}
      zitadel-api:
        condition: service_healthy
{{/if}}

{{/each}}

{{#each backoffices}}
  # ─── BACKOFFICE {{upperCase name}} ─────────────────────────────────────────────────
  backoffice-{{dashCase name}}:
    build:
      context: ../
      dockerfile: apps/backoffice-{{dashCase name}}/Dockerfile
    restart: unless-stopped
    networks:
      - proxy
    environment:
      API_URL: http://{{dashCase apiSource}}-service:{{apiPort}}
      SESSION_SECRET: ${BACKOFFICE_{{constantCase name}}_SESSION_SECRET:?required}
{{#if (eq ../authMode "zitadel")}}
      ZITADEL_PUBLIC_URL: ${ZITADEL_PUBLIC_URL:-https://auth.localhost}
      REDIRECT_URI: ${BACKOFFICE_{{constantCase name}}_APP_URL:-http://backoffice-{{dashCase name}}.localhost}/auth/callback
{{/if}}
    depends_on:
      {{dashCase apiSource}}-service:
        condition: service_healthy

{{/each}}

{{#each portals}}
  # ─── PORTAL {{upperCase name}} ─────────────────────────────────────────────────
  portal-{{dashCase name}}:
    build:
      context: ../
      dockerfile: apps/portal-{{dashCase name}}/Dockerfile
    restart: unless-stopped
    networks:
      - proxy
    environment:
      API_URL: http://{{dashCase apiSource}}-service:{{apiPort}}
      SESSION_SECRET: ${PORTAL_{{constantCase name}}_SESSION_SECRET:?required}
{{#if (eq ../authMode "zitadel")}}
      REDIRECT_URI: ${PORTAL_{{constantCase name}}_APP_URL:-http://portal-{{dashCase name}}.localhost}/auth/callback
{{/if}}
    depends_on:
      {{dashCase apiSource}}-service:
        condition: service_healthy

{{/each}}
